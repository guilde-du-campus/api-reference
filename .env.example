# La Guilde · Variables d'environnement
# Copier ce fichier en .env et ajuster. Le .env ne se commite JAMAIS.

# La chaîne de connexion PostgreSQL.
DATABASE_URL="postgresql://guilde:guilde@localhost:5432/guilde"

# Le secret qui signe les JWT. En production : long, aléatoire, secret.
JWT_SECRET="change-moi-vraiment"

# Les origines autorisées par le CORS, séparées par des virgules.
ALLOWED_ORIGINS="http://localhost:3001"

# L'URL publique de l'API (sert à composer les URLs des médias).
PUBLIC_URL="http://localhost:3000"

# Où stocker les photos uploadées.
MEDIA_DIR="./media"

# Port d'écoute du serveur.
PORT=3000
